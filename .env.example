# Build-time configuration (twelve-factor: config lives in the environment, not in code).
# Only variables prefixed VITE_ are exposed to the browser bundle.

# Path the site is served from. "/" for a custom host or user site,
# "/isoline-browser/" for a GitHub Pages project site (the production default).
VITE_BASE_PATH=/isoline-browser/

# Default analysis parameters shown in the UI (all can be changed per session).
VITE_DEFAULT_MAX_GAP_BP=2000000
VITE_DEFAULT_MAX_GAP_CM=10
VITE_DEFAULT_MIN_SEGMENT_MARKERS=2
VITE_DEFAULT_MAX_MISSING_SPAN=3

# QC thresholds.
VITE_QC_LINE_MISSING_MAX=0.10
VITE_QC_LINE_HET_MAX=0.05
VITE_QC_MARKER_CALLRATE_MIN=0.80
VITE_QC_PARENT_HET_MAX=0.02
