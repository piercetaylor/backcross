# Normalise line endings: the repository is LF everywhere, so a regenerated
# fixture on Windows matches the committed files (CI runs `npm run fixture`
# followed by `git diff --exit-code`).
* text=auto eol=lf

# Fonts are binary. `text=auto` above would normally detect that, but an
# explicit rule is cheaper than discovering a corrupted woff2 later: line-ending
# normalisation applied to a font file silently destroys it.
*.woff2 binary

# The data contract (contract/) is hashed byte for byte in MANIFEST.sha256 and
# mirrored into progeny-selector, so its text must be LF on every checkout and
# its gzip and bgzip cases must never be normalised.
contract/** text eol=lf
# Case files are the generator's bytes verbatim, including the CRLF cases of 1.1.0;
# with text unset git performs no conversion in either direction.
contract/cases/** -text
*.gz binary
*.bgz binary
