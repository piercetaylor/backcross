{
  "name": "backcross",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based characterization and QC of soybean near-isogenic lines against their recurrent and donor parents from SNP genotype files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:bench": "vitest run --project bench",
    "test:watch": "vitest",
    "fixture": "node scripts/make-fixture.mjs",
    "contract": "node scripts/make-contract.mjs",
    "brapi:record": "node scripts/brapi-record.mjs",
    "a11y:lighthouse": "node scripts/lighthouse-a11y.mjs",
    "cli": "node src/cli.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.0",
    "axe-core": "4.13.0",
    "chrome-launcher": "1.2.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lighthouse": "13.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "5.0.0",
    "vitest-browser-react": "^2.3.0"
  }
}
